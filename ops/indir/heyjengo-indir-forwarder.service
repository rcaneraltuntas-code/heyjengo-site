[Unit]
Description=heyJengo minimized download-link analytics forwarder
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/heyjengo-indir
EnvironmentFile=/etc/heyjengo-indir-forwarder.env
ExecStart=/usr/bin/python3 /opt/heyjengo-indir/forwarder.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
StateDirectory=heyjengo-indir-forwarder
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/heyjengo-indir-forwarder
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
